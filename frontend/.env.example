# Public API origin for the deployed FastAPI backend (no trailing slash)
VITE_API_BASE_URL=https://your-api.example.com

# Values from Firebase Console > Project settings > General > Your apps
# Firebase web config is public client configuration, not a server secret.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
