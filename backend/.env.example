# SMTP account credentials (copy this file to .env and fill these in)
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password-or-app-password
MAIL_FROM=notifications@example.com
MAIL_FROM_NAME=HireAI
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# Link used by the call-to-action in notification messages
APP_URL=http://localhost:5173

# Firebase project used for verifying signed-in API requests
FIREBASE_PROJECT_ID=hire-ai-7f6f3

# Comma-separated recruiter emails approved by the project administrator
RECRUITER_EMAILS=recruiter@example.com

# Gemini API access for AI-generated mock interview questions and feedback
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Production settings (set these on your hosting provider, not in source control)
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/hireai
# CORS_ORIGINS=https://your-app.example.com
# APP_URL=https://your-app.example.com
# UPLOAD_DIR=/var/data/hireai-uploads
